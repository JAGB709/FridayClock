# Token que el reloj manda al puente (Ajustes > Token del puente)
BRIDGE_TOKEN=pon-aqui-algo-largo

# Hermes Agent: API_SERVER_ENABLED=true en ~/.hermes/.env y `hermes gateway`
HERMES_URL=http://127.0.0.1:8642
HERMES_API_KEY=el-mismo-que-API_SERVER_KEY
HERMES_MODEL=hermes-agent

# Whisper: tiny/base/small/medium. "small" va bien en CPU; con GPU usa medium + cuda/float16
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8

# Piper (opcional). Sin esto el reloj usa su propio TTS.
# PIPER_MODEL=/models/es_ES-davefx-medium.onnx
